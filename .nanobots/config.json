{
  "version": "0.14.2",
  "owner": "TimHeckel",
  "repo": "nanobots",
  "defaultBranch": "main",
  "board": "Nanobots",
  "humanLabel": "summon-human",
  "wipCap": 1,
  "gates": [
    "npm run test"
  ],
  "hardGates": [
    "the CLI itself (src/**) — changes every future install",
    "the templates (templates/**) — changes what every repo renders",
    "packaging and release (package.json) — the npm publish surface",
    "CI and loop workflows (.github/**)"
  ],
  "actionsEnabled": true,
  "daytona": {
    "snapshot": null,
    "target": "us",
    "autoDeleteMinutes": 60,
    "databaseBootstrap": []
  },
  "ocr": {
    "version": "v1.7.12",
    "blockingSeverities": [
      "critical",
      "high"
    ],
    "maxRounds": 3,
    "autofix": {
      "protectedPaths": []
    }
  },
  "approval": {
    "requireVersionedStart": true
  },
  "stacks": {
    "enabled": false,
    "maxDepth": 3
  },
  "mergePolicy": {
    "autoMergeNonProduction": false,
    "protectedBranches": [
      "main"
    ]
  }
}
