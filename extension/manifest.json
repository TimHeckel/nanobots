{
  "manifest_version": 3,
  "name": "nanobots \u2014 report to the loop",
  "version": "0.16.0",
  "description": "Screenshot \u2192 annotate \u2192 filed as a GitHub issue for your nanobots loop. Plus full report history and a repo-aware agent chat.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://api.cloudflare.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.fireworks.ai/*",
    "https://openrouter.ai/*",
    "https://api.x.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://ntfy.sh/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Report to nanobots",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html"
}
